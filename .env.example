# --- Supabase (database + API) ---
# 1. Buat project gratis di https://supabase.com
# 2. Buka Project Settings → API, salin:
#      - Project URL            → SUPABASE_URL
#      - Service role key       → SUPABASE_SERVICE_ROLE_KEY
#    Service role MELEWATI Row Level Security — jangan pernah bocorkan ke
#    frontend/klien; hanya dipakai server-side (web/src/lib/db.ts).
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#
# 3. Skema database — salah satu dari:
#      a. Tempel isi web/scripts/schema.sql ke Supabase SQL editor (Run), ATAU
#      b. Isi DATABASE_URL di bawah agar seed membuat skema otomatis saat
#         container start / `npm run seed`.
#    DATABASE_URL bersifat OPSIONAL — setelah skema ada, aplikasi berjalan
#    hanya dengan SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
#    Connection string "Transaction pooler" (port 6543, host aws-0-<region>.pooler.supabase.com).
#    Jangan pakai koneksi langsung db.<ref>.supabase.co (port 5432): host tersebut hanya
#    menerbitkan record IPv6 (AAAA), sedangkan jaringan ini hanya mendukung IPv4.
#    SSL otomatis aktif untuk host *.supabase.co / *.supabase.com.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Web (Next.js) ---
WEB_PORT=3000
# Saat produksi: URL publik tanpa garis miring di akhir, mis. https://berita.example.com
# Dipakai untuk URL absolut (API fetch internal, OAuth redirect, sitemap/robots, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (login redaksi) ---
# Buat OAuth Client ID di Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Lalu tambahkan redirect URI berikut ke "Authorized redirect URIs":
#   http://localhost:3000/api/auth/google/callback
#   (ganti domain/port sesuai NEXT_PUBLIC_APP_URL saat produksi — harus sama persis)
# Isi placeholder di bawah dengan kredensial Anda (Client ID & Client Secret).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Penulis tambahan yang diizinkan login, dipisah koma (opsional).
# Penulis bawaan dari seed: fathandwipayana@gmail.com
AUTHOR_EMAILS=

# --- Catatan produksi ---
# 1. NEXT_PUBLIC_APP_URL harus diisi URL publik (https://...) — dipakai untuk sitemap,
#    robots.txt, metadata Open Graph, dan callback OAuth. Salah set = URL
#    salah diindeks mesin pencari / login Google ditolak (redirect_uri_mismatch).
# 2. SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY wajib diisi (lihat bagian atas).
#    Jangan pernah commit kredensial Supabase ke git.
# 3. DATABASE_URL opsional — hanya untuk auto-buat skema via seed (atau tempel
#    web/scripts/schema.sql di SQL editor Supabase).
